# Requerida por el servicio RAG del piloto (proveedor Groq por defecto).
# Ver la sección "Servicio RAG" del README para dónde conseguirlas gratis.
GOOGLE_API_KEY=
GROQ_API_KEY=

# Opcionales, con default razonable — ver CLAUDE.md para la lista completa.
# LLM_PROVEEDORES=groq

# Servicio experimental de visión: apagado por defecto para evitar consumo.
VALIDACION_IMAGENES_ACTIVA=false
VALIDACION_IMAGENES_REINTENTOS=1

# Puerto de la interfaz en Docker (V1 usa 8080).
CHAT_PORT=8081

# Cambiar si otro proceso ocupa uno de estos puertos.
BACKEND_PORT=8001
CIUDADANIA_PORT=8002
RAG_PORT=8003
