# Requeridas por el servicio RAG con el LLM_PROVEEDORES por defecto (groq,gemini).
# Ver la sección "Servicio RAG" del README para dónde conseguirlas gratis.
GOOGLE_API_KEY=
GROQ_API_KEY=

# Opcionales, con default razonable — ver CLAUDE.md para la lista completa.
# LLM_PROVEEDORES=groq,gemini

# Puerto de la interfaz en Docker (V1 usa 8080).
CHAT_PORT=8081

# Cambiar si otro proceso ocupa uno de estos puertos.
BACKEND_PORT=8001
CIUDADANIA_PORT=8002
RAG_PORT=8003
